model User {
    id            String         @id @default(auto()) @map("_id") @db.ObjectId
    name          String?
    email         String?        @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    studySessions StudySession[]
    subscription  Subscription?
    referrer      String?
    payments      Payment[]
    influencerId  String?
}
