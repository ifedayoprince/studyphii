// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Post {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String @db.ObjectId

    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(auto()) @map("_id") @db.ObjectId
    userId                   String  @db.ObjectId
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    sessionToken String   @unique
    userId       String   @db.ObjectId
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    posts         Post[]
}

model VerificationToken {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model LemonSqueezyWebhookEvent {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    eventName       String
    processed       Boolean  @default(false)
    body            Json
    createdAt       DateTime @default(now())
    processingError String?
}

model LemonSqueezyOneTimePayment {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    amount         Float
    currency       String
    status         String
    lemonSqueezyId String   @unique
    createdAt      DateTime @default(now())

    studyGuide   StudyGuide @relation(fields: [studyGuideId], references: [id])
    studyGuideId String     @unique @db.ObjectId

    @@map("Payment")
}

model StudyGuide {
    id                  String    @id @default(auto()) @map("_id") @db.ObjectId
    courseOutline       String
    title               String
    fileName            String
    generatedFor        String?
    isDownloaded        Boolean
    motivationalMessage String
    difficultyLevel     Int
    chapters            Chapter[]

    createdAt DateTime @default(now())

    payment LemonSqueezyOneTimePayment?
}

model Chapter {
    id     String  @id @default(auto()) @map("_id") @db.ObjectId
    title  String
    topics Topic[]

    studyGuide   StudyGuide @relation(fields: [studyGuideId], references: [id])
    studyGuideId String     @db.ObjectId
}

model Topic {
    id                     String   @id @default(auto()) @map("_id") @db.ObjectId
    name                   String
    learningObjective      String
    comprehensionQuestions String[]
    videoSearchQueries     String[]
    videos                 Video[]
    overview               String
    tip                    String

    chapter   Chapter @relation(fields: [chapterId], references: [id])
    chapterId String  @db.ObjectId
}

model Video {
    id             String @id @default(auto()) @map("_id") @db.ObjectId
    youtubeVideoId String
    searchQuery    String

    topic   Topic  @relation(fields: [topicId], references: [id])
    topicId String @db.ObjectId
}
